#!/usr/bin/env python3
"""Compatibility entry point for the plugin's Python discovery engine."""
import importlib
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
# Load the checkout's engine without requiring a package installation.
affected_tests = importlib.import_module("beton_checks.discovery").affected_tests

if __name__ == "__main__":
    for test in affected_tests(Path(sys.argv[1]), Path(sys.argv[2])):
        print(test)
