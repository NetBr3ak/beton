#!/usr/bin/env bash
# bin/typecheck-file <filepath>
# Exit 0 = clean, 1 = type errors, 0 if no tool available.
set -euo pipefail

FILE="${1:-}"
[ -z "${FILE}" ] || [ ! -f "${FILE}" ] && exit 1

# shellcheck source=bin/lib.sh
source "$(dirname "$0")/lib.sh"
TIMEOUT="${BETON_TC_TIMEOUT:-5}"

case "${FILE##*.}" in
  py)
    if command -v mypy &>/dev/null; then
      # Respect user config when present (mypy.ini, .mypy.ini, pyproject.toml [tool.mypy], setup.cfg [mypy]).
      # Only inject our defaults if no config is reachable.
      D=$(cd "$(dirname "${FILE}")" && pwd)
      FILE="$D/$(basename "${FILE}")"
      MYPY_CONFIG=""
      while [ "$D" != "/" ]; do
        for c in mypy.ini .mypy.ini setup.cfg; do
          [ -f "$D/$c" ] && grep -q "^\[mypy" "$D/$c" 2>/dev/null && MYPY_CONFIG="$D/$c" && break 2
        done
        if [ -f "$D/pyproject.toml" ] && grep -q "^\[tool.mypy" "$D/pyproject.toml" 2>/dev/null; then
          MYPY_CONFIG="$D/pyproject.toml"; break
        fi
        D=$(dirname "$D")
      done
      if [ -n "$MYPY_CONFIG" ]; then
        # Resolve paths in project settings from the project, not the hook caller.
        (cd "$D" && _timeout "${TIMEOUT}" mypy --config-file "$MYPY_CONFIG" "${FILE}"); exit $?
      else
        _timeout "${TIMEOUT}" mypy --ignore-missing-imports --no-error-summary "${FILE}"; exit $?
      fi
    elif command -v pyright &>/dev/null; then
      _timeout "${TIMEOUT}" pyright "${FILE}"; exit $?
    fi
    ;;
  go)
    if command -v go &>/dev/null; then
      DIR=$(dirname "${FILE}")
      OUT=$(_timeout "${TIMEOUT}" go vet "${DIR}/..." 2>&1) || { echo "${OUT}"; exit 1; }
    fi
    ;;
  ts|tsx)
    TSCONFIG=$(python3 - "${FILE}" << 'PYEOF'
import os, sys
d = os.path.dirname(os.path.abspath(sys.argv[1]))
for _ in range(8):
    t = os.path.join(d, 'tsconfig.json')
    if os.path.exists(t):
        print(t); sys.exit(0)
    parent = os.path.dirname(d)
    if parent == d: break
    d = parent
PYEOF
    )
    if command -v tsc &>/dev/null && [ -n "${TSCONFIG}" ]; then
      STATUS=0
      # tsc prints paths relative to its working directory, so run it in the tsconfig directory.
      OUT=$(cd "$(dirname "${TSCONFIG}")" && _timeout "${TIMEOUT}" tsc --project "${TSCONFIG}" --noEmit --pretty false --listFiles --diagnostics false --extendedDiagnostics false --traceResolution false --explainFiles false 2>&1) || STATUS=$?
      [ "$STATUS" -eq 0 ] && exit 0
      # Match source diagnostics by resolved path to avoid catching same-named files.
      # Configuration and global compiler errors invalidate the entire check.
      OWN=$(printf '%s\n' "${OUT}" | python3 -c '
import os, re, sys
base, target = sys.argv[1], os.path.realpath(sys.argv[2])
status = int(sys.argv[3])
raw_lines = list(sys.stdin)
file_diagnostic = re.compile(r"(.+?)\(\d+,\d+\): error ")
# --listFiles identifies JSON modules as source, unlike inherited config files.
sources = {
    os.path.normpath(line.rstrip("\r\n"))
    for line in raw_lines
    if os.path.isabs(line) and not file_diagnostic.match(line)
}
lines = [
    line for line in raw_lines
    if os.path.normpath(line.rstrip("\r\n")) not in sources
]
config = os.path.realpath(sys.argv[4])
diagnostics = False
unrecognized = False
selected = []
own = False
for line in lines:
    m = file_diagnostic.match(line)
    if m:
        diagnostics = True
        path = os.path.normpath(os.path.join(base, m.group(1)))
        source = path in sources
        if not sources:
            source = path.endswith((".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"))
        own = os.path.realpath(path) in (target, config) or not source
    elif re.match(r"error TS\d+:", line):
        diagnostics = True
        own = True
    elif not line.startswith(" "):
        own = False
        unrecognized = unrecognized or bool(line.strip())
    if own:
        selected.append(line)
# Only ordinary diagnostics in other source files can be ignored. A compiler
# crash or an unrecognized failure means the requested check did not complete.
if status not in (0, 1, 2) or (status and (not diagnostics or unrecognized)):
    print("".join(lines).strip() or f"TypeScript compiler exited with status {status} (no output).")
else:
    print("".join(selected), end="")
' "$(dirname "${TSCONFIG}")" "${FILE}" "$STATUS" "${TSCONFIG}")
      if [ -n "${OWN}" ]; then
        printf '%s\n' "${OWN}"
        [ "$STATUS" -eq 124 ] && exit 124
        exit 1
      fi
    fi
    ;;
esac
exit 0
